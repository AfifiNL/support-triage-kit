{
  "name": "Support triage: deliver approved replies",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      },
      "id": "a682a4de-a00a-58bd-aaa3-ba730e0c35f6",
      "name": "Every 5 minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.TRIAGE_API_URL }}/v1/outbox",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.TRIAGE_OUTBOX_TOKEN }}"
            }
          ]
        },
        "options": {}
      },
      "id": "a1d6403d-c457-5895-a2fe-3e302ae81a88",
      "name": "Fetch outbox",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.HELPDESK_REPLY_URL }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.HELPDESK_TOKEN }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ ticket_id: $json.ticket_id, reply: $json.reply }) }}",
        "options": {}
      },
      "id": "7fce870c-809f-580a-9d4d-bfaddbe55d21",
      "name": "Send reply via helpdesk API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ],
      "notes": "Point HELPDESK_REPLY_URL at your helpdesk's reply endpoint, or replace this node with your helpdesk's own n8n node. An error here stops the run, so nothing is acknowledged that was not sent."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.TRIAGE_API_URL }}/v1/outbox/{{ $('Fetch outbox').item.json.id }}/ack",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.TRIAGE_OUTBOX_TOKEN }}"
            }
          ]
        },
        "options": {}
      },
      "id": "d6a78399-7035-56cb-aa7a-3b5616d106c9",
      "name": "Acknowledge delivery",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        0
      ]
    }
  ],
  "connections": {
    "Every 5 minutes": {
      "main": [
        [
          {
            "node": "Fetch outbox",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch outbox": {
      "main": [
        [
          {
            "node": "Send reply via helpdesk API",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send reply via helpdesk API": {
      "main": [
        [
          {
            "node": "Acknowledge delivery",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {}
}
