{
  "name": "Support triage: deliver approved replies",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      },
      "id": "a682a4de-a00a-58bd-aaa3-ba730e0c35f6",
      "name": "Every 5 minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.TRIAGE_API_URL }}/v1/outbox",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.TRIAGE_REVIEW_TOKEN }}"
            }
          ]
        },
        "options": {}
      },
      "id": "a1d6403d-c457-5895-a2fe-3e302ae81a88",
      "name": "Fetch outbox",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {},
      "id": "8cfe971d-4864-535c-9046-674638952d46",
      "name": "Send reply through your helpdesk",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        440,
        0
      ],
      "notes": "Replace with your helpdesk node (it receives ticket_id and reply). Only approved replies reach this point."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.TRIAGE_API_URL }}/v1/outbox/{{ $json.id }}/ack",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.TRIAGE_REVIEW_TOKEN }}"
            }
          ]
        },
        "options": {}
      },
      "id": "d6a78399-7035-56cb-aa7a-3b5616d106c9",
      "name": "Acknowledge delivery",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        0
      ]
    }
  ],
  "connections": {
    "Every 5 minutes": {
      "main": [
        [
          {
            "node": "Fetch outbox",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch outbox": {
      "main": [
        [
          {
            "node": "Send reply through your helpdesk",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send reply through your helpdesk": {
      "main": [
        [
          {
            "node": "Acknowledge delivery",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {}
}
